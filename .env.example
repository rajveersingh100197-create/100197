# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet / backend is hosted (e.g. https://your-project.vercel.app)
APP_URL="MY_APP_URL"

# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
# Bot token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Secret token used to verify incoming Telegram webhooks (X-Telegram-Bot-Api-Secret-Token header)
TELEGRAM_WEBHOOK_SECRET="YOUR_TELEGRAM_WEBHOOK_SECRET"

# ==========================================
# PAYMENT PROVIDER CONFIGURATION (Razorpay / Cashfree / Custom Webhook)
# ==========================================
# Payment Gateway Provider ('razorpay' | 'cashfree' | 'custom')
PAYMENT_PROVIDER="razorpay"

# Server-side API credentials for creating payment links/orders
PAYMENT_KEY_ID="YOUR_PAYMENT_KEY_ID"
PAYMENT_KEY_SECRET="YOUR_PAYMENT_KEY_SECRET"

# Webhook secret used for HMAC-SHA256 signature verification of payment webhooks
PAYMENT_WEBHOOK_SECRET="YOUR_PAYMENT_WEBHOOK_SECRET"

# Campaign Entry Fee in INR (Default: 199)
CAMPAIGN_ENTRY_FEE="199"

# ==========================================
# DATABASE & ADMIN CONFIGURATION
# ==========================================
# SQLite database path (or Postgres connection URL for external DB)
DATABASE_PATH="./data/diwalibigdeal.sqlite"
DATABASE_URL="postgresql://user:password@localhost:5432/diwalibigdeal"

# Optional Admin API token for accessing administrative endpoints
ADMIN_API_SECRET="YOUR_ADMIN_SECRET_KEY"

