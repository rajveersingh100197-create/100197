{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/telegram/webhook",
      "destination": "/api/telegram/webhook"
    },
    {
      "source": "/api/payment/webhook",
      "destination": "/api/payment/webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
